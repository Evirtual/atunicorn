{
  "name": "atunicorn.io",
  "version": "0.0.0",
  "private": true,
  "description": "quick and simple way to share",
  "main": "index.js",
  "workspaces": {
    "packages": [
      "@packs/**"
    ]
  },
  "scripts": {
    "dev": "next dev --webpack -p 8080",
    "start": "firebase emulators:start --only hosting --project unicorn-ee877",
    "build": "next build --webpack",
    "export": "yarn build",
    "serve": "yarn start",
    "static": "yarn build && yarn start",
    "deploy": "yarn build && firebase deploy --project unicorn-ee877",
    "storage:worker:dev": "wrangler dev --config workers/cloudinary-storage/wrangler.toml",
    "storage:worker:deploy": "wrangler deploy --config workers/cloudinary-storage/wrangler.toml"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "firebase": "12.16.0",
    "markdown-to-jsx": "9.9.0",
    "next": "16.2.11",
    "pack": "0.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-image-file-resizer": "0.4.8",
    "react-native-web": "0.21.2",
    "styled-components": "^6.4.4"
  },
  "devDependencies": {
    "firebase-tools": "^15.24.0",
    "wrangler": "^4.112.0"
  },
  "resolutions": {
    "next/postcss": "8.5.23",
    "sharp": "0.35.3",
    "nanoid": "3.3.17",
    "protobufjs": "7.6.5"
  },
  "author": "",
  "license": "ISC",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
