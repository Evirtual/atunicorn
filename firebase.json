{
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/post/**",
        "destination": "/post/[id]/index.html"
      },
      {
        "source": "/profile/**/about",
        "destination": "/profile/[id]/about/index.html"
      },
      {
        "source": "/profile/**",
        "destination": "/profile/[id]/index.html"
      },
      {
        "source": "/**",
        "destination": "/[id]/index.html"
      }
    ]
  }
}
